	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1741879700638</Id>
			<Name><![CDATA[MyClass]]></Name>
			<Text><![CDATA[/**
 * MyClass
 */	
public class MyClass extends Agent implements ICarsToRoad {
    /**
     * Конструктор по умолчанию
     */
    public MyClass() {
    	this._count=0;
    }
    
    public MyClass( Engine engine, Agent owner, AgentList<? extends MyClass> ownerPopulation ) {
        super( engine, owner, ownerPopulation );
        this._count=0;
    }
    
    public int _count;

	@Override
	public String toString() {
		return super.toString();
	}
	
	public int hours;
	public int minutes;
	public int seconds;

	@Override
	public int getHour() {
	    double totalSeconds = time();
	    return (int)(totalSeconds / 3600);
	}

	@Override
	public int getMinute() {
	    double totalSeconds = time();
	    int remainingSeconds = (int)(totalSeconds % 3600);
	    return remainingSeconds / 60;
	}

	@Override
	public int getSecond() {
	    double totalSeconds = time();
	    int remainingSeconds = (int)(totalSeconds % 3600);
	    return remainingSeconds % 60;
	}
	
	@Override
	public int AddCars() {
	    this._count++;
	    return this._count;
	}

	
	@Override
	public void ClearCars() {
		this._count = 0;
	}
}














]]></Text>
		</JavaClass>
